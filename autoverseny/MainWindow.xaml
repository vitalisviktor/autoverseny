<Window x:Class="autoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:autoverseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="btn_start" Content="Start" Width="90" Height="45" Grid.Row="1" Background="CornflowerBlue" Click="btn_start_Click"/>
        <ListBox x:Name="lbx_valasztas" Grid.Row="1" Width="100" Height="70" HorizontalAlignment="Left"></ListBox>
        <Canvas x:Name="cnv_palya" Background="AliceBlue" Grid.Row="3">
            <Button x:Name="btn_ferrari" Content="Ferrari" Height="45" Width="90" Background="Red" Canvas.Left="20" Canvas.Top="50" />
            <Button x:Name="btn_lambo" Content="Lamborghini" Height="45" Width="90" Background="Yellow" Canvas.Left="20" Canvas.Top="150" />
            <Button x:Name="btn_porsche" Content="Porsche" Height="45" Width="90" Background="Gray" Canvas.Left="20" Canvas.Top="250" />
        </Canvas>
    </Grid>
</Window>
